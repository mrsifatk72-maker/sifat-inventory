# ---------------------------------------------------------------------------
# MediVerse Dental CMS — environment variables (names only, NO real values).
# Copy to .env.local for local work. Never commit real values.
# On Vercel: Project → Settings → Environment Variables (Preview + Production).
# ---------------------------------------------------------------------------

# --- Server-only (Vercel Functions). NEVER expose to the browser. -----------
SUPABASE_URL=                      # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=                 # public "anon"/publishable key — RLS protects data
SUPABASE_SERVICE_ROLE_KEY=         # SECRET. Bypasses RLS. Server only: analytics ingest + admin invites
SITE_URL=                          # e.g. https://<preview>.vercel.app  (later: https://dental.mediversebd.com)
ADMIN_URL=                         # e.g. https://<preview>.vercel.app/admin
ANALYTICS_ENABLED=true             # kill switch for /api/track

# --- Admin panel build (Vite). Safe to be public by design. -----------------
VITE_SUPABASE_URL=                 # same as SUPABASE_URL
VITE_SUPABASE_ANON_KEY=            # same as SUPABASE_ANON_KEY (NOT the service role key)
VITE_TURNSTILE_SITE_KEY=           # Cloudflare Turnstile site key for the login form

# --- Supabase CLI only (local `supabase start` / `supabase config push`) ---
SUPABASE_AUTH_CAPTCHA_SECRET=      # Turnstile secret key; lives in Supabase Auth settings, not in Vercel
SUPABASE_ACCESS_TOKEN=             # personal access token for the CLI (your machine only)
SUPABASE_DB_PASSWORD=              # database password (your machine only)
